<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SongStash.Desktop.ViewModels"
             xmlns:app="using:SongStash.Application.Library"
             x:Class="SongStash.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="2">
      <StackPanel Spacing="3"><TextBlock Text="{Binding Strings.Title}" FontSize="29" FontWeight="Bold" /><TextBlock Text="{Binding Strings.Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>

      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
        <Border Classes="settings-section" Padding="12"><StackPanel Spacing="4"><TextBlock Text="♫" FontSize="22" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding TotalSongs}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding Strings.TotalSongs}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="settings-section" Padding="12"><StackPanel Spacing="4"><TextBlock Text="◷" FontSize="22" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding TotalFinds}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding Strings.TotalFinds}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="settings-section" Padding="12"><StackPanel Spacing="4"><TextBlock Text="♥" FontSize="22" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding FavoritesCount}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding Strings.Favorites}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Border>
        <Border Grid.Column="3" Classes="settings-section" Padding="12"><StackPanel Spacing="4"><TextBlock Text="♙" FontSize="22" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding ArtistsCount}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding Strings.Artists}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Border>
        <Border Grid.Column="4" Classes="settings-section" Padding="12"><StackPanel Spacing="4"><TextBlock Text="♬" FontSize="22" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding GenresCount}" FontSize="23" FontWeight="Bold" /><TextBlock Text="{Binding Strings.Genres}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></Border>
      </Grid>

      <Border Classes="notice-neutral" IsVisible="{Binding IsEmptyLibrary}"><StackPanel Spacing="5"><TextBlock Text="{Binding Strings.EmptyTitle}" FontSize="20" FontWeight="Bold" /><TextBlock Text="{Binding Strings.EmptyDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
        <Border Classes="settings-section">
          <StackPanel Spacing="9"><TextBlock Text="{Binding Strings.RecentlyFound}" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding RecentFinds}" HorizontalAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OverviewSongActionViewModel">
              <Button Classes="overview-item" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4">
                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="40,*,Auto" ColumnSpacing="8"><Border Width="38" Height="38" CornerRadius="7" Background="{DynamicResource PlaceholderBrush}"><TextBlock Text="♫" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding DateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding Strings.NoRecentFinds}" IsVisible="{Binding HasRecentFinds, Converter={x:Static BoolConverters.Not}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="settings-section">
          <StackPanel Spacing="9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Strings.Favorites}" FontSize="18" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding FavoritesCount}" Foreground="{DynamicResource AccentBrush}" /></Grid>
            <ItemsControl ItemsSource="{Binding FavoriteSongs}" HorizontalAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel HorizontalAlignment="Stretch" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OverviewSongActionViewModel">
              <Button Classes="overview-item" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4">
                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="40,*,Auto" ColumnSpacing="8"><Border Width="38" Height="38" CornerRadius="7" Background="{DynamicResource PlaceholderBrush}"><TextBlock Text="♫" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" /></StackPanel><TextBlock Grid.Column="2" Text="♥" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" /></Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding Strings.NoFavorites}" IsVisible="{Binding HasFavorites, Converter={x:Static BoolConverters.Not}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="settings-section">
          <StackPanel Spacing="9"><TextBlock Text="{Binding Strings.TopArtists}" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding TopArtists}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:OverviewArtistItem"><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding SongCount, StringFormat='{}{0} songs'}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding Strings.NoArtists}" IsVisible="{Binding HasTopArtists, Converter={x:Static BoolConverters.Not}}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="settings-section">
          <StackPanel Spacing="9"><TextBlock Text="{Binding Strings.TopGenres}" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding TopGenres}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:OverviewGenreItem"><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding SongCount, StringFormat='{}{0} songs'}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding Strings.NoGenres}" IsVisible="{Binding HasTopGenres, Converter={x:Static BoolConverters.Not}}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="settings-section">
          <StackPanel Spacing="9"><TextBlock Text="{Binding Strings.RecentAlbums}" FontSize="18" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding RecentAlbums}" HorizontalAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" HorizontalAlignment="Stretch" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OverviewAlbumActionViewModel">
              <Button Classes="overview-item" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Stretch" Spacing="4"><Border Height="64" CornerRadius="7" Background="{DynamicResource PlaceholderBrush}"><TextBlock Text="◉" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LatestFoundLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel></Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding Strings.NoAlbums}" IsVisible="{Binding HasRecentAlbums, Converter={x:Static BoolConverters.Not}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Classes="settings-section"><StackPanel Spacing="9"><TextBlock Text="{Binding Strings.PopularTags}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Strings.TagsUnavailable}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
      </Grid>
      <Border Classes="notice-error" IsVisible="{Binding HasError}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
